test rfc4231_tc5_truncated() -> (result: TestResult) {
    let key: HmacKey = hmac_key([12, 12, 12, 12, 12, 12, 12, 12, 12, 12, 12, 12, 12, 12, 12, 12, 12, 12, 12, 12]);
    let msg: [byte; up_to 192] = [84, 101, 115, 116, 32, 87, 105, 116, 104, 32, 84, 114, 117, 110, 99, 97, 116, 105, 111, 110];
    let got: [byte; 16] = hmac_sha256_128(key, msg).bytes;
    let want: [byte; 16] = [
    163, 182, 22, 116, 115, 16, 14, 224, 110, 12, 121, 108, 41, 85, 85, 43
];
    return from_assertion(equals_bytes(want, got, 8305));
}

test rfc4231_tc6_long_key() -> (result: TestResult) {
    // 131-byte key: exercises the pre-hash path.
    let key: HmacKey = hmac_key([170, 170, 170, 170, 170, 170, 170, 170, 170, 170, 170, 170, 170, 170, 170, 170, 170, 170, 170, 170, 170, 170, 170, 170, 170, 170, 170, 170, 170, 170, 170, 170, 170, 170, 170, 170, 170, 170, 170, 170, 170, 170, 170, 170, 170, 170, 170, 170, 170, 170, 170, 170, 170, 170, 170, 170, 170, 170, 170, 170, 170, 170, 170, 170, 170, 170, 170, 170, 170, 170, 170, 170, 170, 170, 170, 170, 170, 170, 170, 170, 170, 170, 170, 170, 170, 170, 170, 170, 170, 170, 170, 170, 170, 170, 170, 170, 170, 170, 170, 170, 170, 170, 170, 170, 170, 170, 170, 170, 170, 170, 170, 170, 170, 170, 170, 170, 170, 170, 170, 170, 170, 170, 170, 170, 170, 170, 170, 170, 170, 170, 170]);
    let msg: [byte; up_to 192] = [84, 101, 115, 116, 32, 85, 115, 105, 110, 103, 32, 76, 97, 114, 103, 101, 114, 32, 84, 104, 97, 110, 32, 66, 108, 111, 99, 107, 45, 83, 105, 122, 101, 32, 75, 101, 121, 32, 45, 32, 72, 97, 115, 104, 32, 75, 101, 121, 32, 70, 105, 114, 115, 116];
    let got: [byte; 32] = hmac_sha256(key, msg).bytes;
    let want: [byte; 32] = [
    96, 228, 49, 89, 30, 224, 182, 127, 13, 138, 38, 170, 203, 245, 183, 127,
    142, 11, 198, 33, 55, 40, 197, 20, 5, 70, 4, 15, 14, 227, 127, 84
];
    return from_assertion(equals_bytes(want, got, 8306));
}

test rfc4231_tc7_long_key_long_data() -> (result: TestResult) {
    // 131-byte key with 152-byte message: both long paths at once.
    let key: HmacKey = hmac_key([170, 170, 170, 170, 170, 170, 170, 170, 170, 170, 170, 170, 170, 170, 170, 170, 170, 170, 170, 170, 170, 170, 170, 170, 170, 170, 170, 170, 170, 170, 170, 170, 170, 170, 170, 170, 170, 170, 170, 170, 170, 170, 170, 170, 170, 170, 170, 170, 170, 170, 170, 170, 170, 170, 170, 170, 170, 170, 170, 170, 170, 170, 170, 170, 170, 170, 170, 170, 170, 170, 170, 170, 170, 170, 170, 170, 170, 170, 170, 170, 170, 170, 170, 170, 170, 170, 170, 170, 170, 170, 170, 170, 170, 170, 170, 170, 170, 170, 170, 170, 170, 170, 170, 170, 170, 170, 170, 170, 170, 170, 170, 170, 170, 170, 170, 170, 170, 170, 170, 170, 170, 170, 170, 170, 170, 170, 170, 170, 170, 170, 170]);
    let msg: [byte; up_to 192] = [84, 104, 105, 115, 32, 105, 115, 32, 97, 32, 116, 101, 115, 116, 32, 117, 115, 105, 110, 103, 32, 97, 32, 108, 97, 114, 103, 101, 114, 32, 116, 104, 97, 110, 32, 98, 108, 111, 99, 107, 45, 115, 105, 122, 101, 32, 107, 101, 121, 32, 97, 110, 100, 32, 97, 32, 108, 97, 114, 103, 101, 114, 32, 116, 104, 97, 110, 32, 98, 108, 111, 99, 107, 45, 115, 105, 122, 101, 32, 100, 97, 116, 97, 46, 32, 84, 104, 101, 32, 107, 101, 121, 32, 110, 101, 101, 100, 115, 32, 116, 111, 32, 98, 101, 32, 104, 97, 115, 104, 101, 100, 32, 98, 101, 102, 111, 114, 101, 32, 98, 101, 105, 110, 103, 32, 117, 115, 101, 100, 32, 98, 121, 32, 116, 104, 101, 32, 72, 77, 65, 67, 32, 97, 108, 103, 111, 114, 105, 116, 104, 109, 46];
    let got: [byte; 32] = hmac_sha256(key, msg).bytes;
    let want: [byte; 32] = [
    155, 9, 255, 167, 27, 148, 47, 203, 39, 99, 95, 188, 213, 176, 233, 68,
    191, 220, 99, 100, 79, 7, 19, 147, 138, 127, 81, 83, 92, 58, 53, 226
];
    return from_assertion(equals_bytes(want, got, 8307));
}

test tampered_message_fails_verification() -> (result: TestResult) {
    let key: HmacKey = hmac_key([74, 101, 102, 101]);
    let msg: [byte; up_to 192] = [119, 104, 97, 116, 32, 100, 111, 32, 121, 97, 32, 119, 97, 110, 116, 32, 102, 111, 114, 32, 110, 111, 116, 104, 105, 110, 103, 63];
    let good: Tag = hmac_sha256(key, msg);
    let bad_msg: [byte; up_to 192] = [119, 104, 97, 116, 32, 100, 111, 32, 121, 97, 32, 119, 97, 110, 116, 32, 102, 111, 114, 32, 110, 111, 116, 104, 105, 110, 103, 64];
    let a: bool = hmac_verify(key, msg, good);
    let b: bool = a && !hmac_verify(key, bad_msg, good);
    return from_assertion(equals_bool(true, b, 8308));
}

test wrong_key_fails_verification() -> (result: TestResult) {
    let key: HmacKey = hmac_key([74, 101, 102, 101]);
    let other: HmacKey = hmac_key([74, 101, 102, 102]);
    let msg: [byte; up_to 192] = [72, 105, 32, 84, 104, 101, 114, 101];
    let good: Tag = hmac_sha256(key, msg);
    let a: bool = hmac_verify(key, msg, good);
    let b: bool = a && !hmac_verify(other, msg, good);
    return from_assertion(equals_bool(true, b, 8309));
}

test empty_key_is_well_defined() -> (result: TestResult) {
    // An empty key pads to the all-zero block; the operation stays total.
    let key: HmacKey = hmac_key([]);
    let msg: [byte; up_to 192] = [97, 98, 99];
    let again: Tag = hmac_sha256(key, msg);
    return from_assertion(equals_bool(true, hmac_verify(key, msg, again), 8310));
}
