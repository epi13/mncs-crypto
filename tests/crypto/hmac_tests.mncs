mncs 0.18;

// Proofs of mncs.crypto.hmac: RFC 4231 test cases 1-7, truncation,
// tamper and wrong-key rejection, determinism. Expected tags are pinned
// from the RFC text and confirmed by the OpenSSL-backed hmac oracle.
module tests.crypto.hmac_tests;

// Long literals below were machine-emitted by scripts/mncs_bytes.py
// from pinned hex, never hand-typed.
use mncs.crypto.hmac;
use mncs.crypto.types;
use mncs.test.assertions;
use mncs.test.suite;

test rfc4231_tc1() -> (result: TestResult) {
    let key: HmacKey = hmac_key([11, 11, 11, 11, 11, 11, 11, 11, 11, 11, 11, 11, 11, 11, 11, 11, 11, 11, 11, 11]);
    let msg: [byte; up_to 192] = [72, 105, 32, 84, 104, 101, 114, 101];
    let got: [byte; 32] = hmac_sha256(key, msg).bytes;
    let want: [byte; 32] = [
    176, 52, 76, 97, 216, 219, 56, 83, 92, 168, 175, 206, 175, 11, 241, 43,
    136, 29, 194, 0, 201, 131, 61, 167, 38, 233, 55, 108, 46, 50, 207, 247
];
    return from_assertion(equals_bytes(want, got, 8301));
}

test rfc4231_tc2() -> (result: TestResult) {
    let key: HmacKey = hmac_key([74, 101, 102, 101]);
    let msg: [byte; up_to 192] = [119, 104, 97, 116, 32, 100, 111, 32, 121, 97, 32, 119, 97, 110, 116, 32, 102, 111, 114, 32, 110, 111, 116, 104, 105, 110, 103, 63];
    let got: [byte; 32] = hmac_sha256(key, msg).bytes;
    let want: [byte; 32] = [
    91, 220, 193, 70, 191, 96, 117, 78, 106, 4, 36, 38, 8, 149, 117, 199,
    90, 0, 63, 8, 157, 39, 57, 131, 157, 236, 88, 185, 100, 236, 56, 67
];
    return from_assertion(equals_bytes(want, got, 8302));
}

